# Copiez ce fichier en ".env" (à la racine, à côté de manage.py) et remplissez-le.
# Ne JAMAIS committer le fichier .env réel dans git (Phase 14 - Sécurité).

# Clé API Anthropic (obligatoire pour que le chatbot génère de vraies réponses).
ANTHROPIC_API_KEY=

# Modèle LLM utilisé (Étape 6)
MPG_LLM_MODEL=claude-sonnet-4-6

# Sécurité Django (Phase 14) — générez une vraie clé en production :
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=

DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Paramètres RAG (Étape 5) — valeurs de départ, à calibrer (Étape 7)
MPG_RAG_TOP_K=5
MPG_HISTORY_SIZE=8
MPG_STALE_MONTHS=12
